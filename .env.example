# Database configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tablesync?schema=public"

# Redis cache & pub/sub configuration
REDIS_URL="redis://localhost:6379"

# WebSockets server configuration
NEXT_PUBLIC_WS_URL="http://localhost:3001"
PORT=3001

# Next.js Frontend URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
